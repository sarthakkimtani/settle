{
  "expo": {
    "name": "Settle",
    "slug": "settle",
    "scheme": "settle",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "platforms": ["ios", "android"],
    "ios": {
      "supportsTablet": false,
      "icon": "./assets/icons/ios.icon",
      "bundleIdentifier": "com.app.settle"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#4EA085",
        "foregroundImage": "./assets/icons/android.png",
        "monochromeImage": "./assets/icons/android.png"
      },
      "package": "com.app.settle",
      "softwareKeyboardLayoutMode": "pan",
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/icons/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#4EA085"
        }
      ],
      [
        "expo-font",
        {
          "android": {
            "fonts": [
              {
                "fontFamily": "Inter",
                "fontDefinitions": [
                  {
                    "path": "./assets/fonts/Inter-Variable.ttf",
                    "weight": 100
                  },
                  {
                    "path": "./assets/fonts/Inter-Variable.ttf",
                    "weight": 400
                  },
                  {
                    "path": "./assets/fonts/Inter-Variable.ttf",
                    "weight": 700
                  }
                ]
              },
              {
                "fontFamily": "Lato",
                "fontDefinitions": [
                  {
                    "path": "./assets/fonts/Lato-Regular.ttf",
                    "weight": 400
                  },
                  {
                    "path": "./assets/fonts/Lato-Bold.ttf",
                    "weight": 700
                  }
                ]
              }
            ]
          },
          "ios": {
            "fonts": [
              "./assets/fonts/Inter-Variable.ttf",
              "./assets/fonts/Lato-Regular.ttf",
              "./assets/fonts/Lato-Bold.ttf"
            ]
          }
        }
      ],
      "expo-image",
      "expo-web-browser",
      "expo-secure-store",
      "@clerk/expo"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
