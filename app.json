{
  "expo": {
    "name": "Settle",
    "slug": "settle",
    "scheme": "settle",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "platforms": ["ios", "android"],
    "ios": {
      "supportsTablet": false,
      "icon": "./assets/icons/ios.icon",
      "bundleIdentifier": "com.app.settle"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#4EA085",
        "foregroundImage": "./assets/icons/android.png",
        "monochromeImage": "./assets/icons/android.png"
      },
      "package": "com.app.settle",
      "softwareKeyboardLayoutMode": "pan",
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/icons/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#4EA085"
        }
      ],
      "expo-font",
      "expo-image",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
